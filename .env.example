# erxes core (apps/core-api). Copy to .env for local development.
NODE_ENV=development
PORT=3400

# Postgres for core (core_* tables). Local: docker compose up -d
DATA_URL=postgres://erxes:erxes_local_dev@127.0.0.1:5434/erxes
# Production: DATA_URL is the runtime role (data only, no BYPASSRLS: pnpm db:grant -- erxes_app),
# DATA_MIGRATION_URL the owner for `pnpm db:migrate` (DATA_RUNTIME_ROLE=erxes_app re-grants after).
# DATA_MIGRATION_URL=postgres://owner:…@host:5432/erxes
# DATA_RUNTIME_ROLE=erxes_app
# Migrate when the API starts (default: true in development, false in production).
# DATA_MIGRATE_ON_START=true
# Act as this role on each connection (session connections only, e.g. owner login + SET ROLE).
# DATA_ROLE=erxes_app
# TLS to Postgres is verified. Give the server's CA when it isn't a public one (Supabase, RDS):
# DATA_SSL=true
# DATA_SSL_CA_FILE=/run/secrets/postgres_ca.pem
# Development only (refused in production): TLS without verifying the certificate.
# DATA_SSL_INSECURE=true
# DATA_URL_FILE=/run/secrets/data_url
# DATA_SSL=false
# DATA_POOL_MAX=10
# DATA_STATEMENT_TIMEOUT_MS=15000

# Signs core access tokens (until the sign-in slice adds RS256 keys). Required in production.
CORE_JWT_SECRET=replace-with-a-long-random-secret
# Core's signing key (ES256; plugin tokens, audit checkpoints). Required in production:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
# Development generates data/keys/signing-key.pem when unset.
# CORE_SIGNING_KEY_FILE=/run/secrets/core_signing_key
# Previous keys (PEM), still published so older signatures verify:
# CORE_SIGNING_KEYS_RETIRED_FILE=/run/secrets/core_signing_keys_retired

# Tests: a Postgres where each test file creates and drops its own database
# DATA_TEST_URL=postgres://erxes:erxes_local_dev@127.0.0.1:5434/postgres

# First-run setup screen while the database has no organisation (false on SaaS).
CORE_SETUP=true

# Plugin client secrets: `<plugin>:<secret>` pairs (secret ≥ 32 chars), comma-separated,
# registered (hashed) at startup. Or: pnpm plugin:secret -- hr (prints a new one).
# A plugin exchanges its secret for 15-minute tokens: POST /core/v1/plugins/token.
# CORE_PLUGIN_KEYS=hr:replace-with-a-long-random-secret-for-hr
# Install every plugin in every organisation (default: on unless CORE_SETUP=false).
# PLUGINS_AUTO_INSTALL=true

# File storage: local (this server's disk) or s3 (AWS S3, Cloudflare R2, MinIO …)
# FILES_STORAGE=local
# FILES_LOCAL_DIR=./data/files
# S3_BUCKET=erxes-files
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # true for MinIO
# The bucket needs CORS allowing PUT from the erxes address (browsers upload directly).
# FILES_MAX_SIZE_MB=50          # deployment limit; organisations can only lower it
# FILES_LINK_TTL_SECONDS=300    # how long upload/download links work
# FILES_PENDING_TTL_HOURS=24    # unfinished uploads are removed after this

# Retention
# AUDIT_RETENTION_DAYS=365
# NOTIFICATIONS_RETENTION_DAYS=90   # read notifications only

# Live updates: a connection that stays open for LISTEN (Postgres directly, or
# Supabase's session pooler on :5432). Derived from DATA_URL when unset (a
# Supabase :6543 URL becomes :5432); `off` disables live updates (browsers poll).
# DATA_LISTEN_URL=
# LIVE_MAX_STREAMS_PER_USER=10

# Handled events are removed after this many days.
# EVENTS_RETENTION_DAYS=30

# Seals secrets core reads back (webhook secrets, payment keys). Default: derived from CORE_JWT_SECRET.
# CORE_ENCRYPTION_KEY_FILE=/run/secrets/core_encryption_key
# Webhooks/automations may call http and private addresses (default: development only).
# OUTBOUND_ALLOW_PRIVATE=false

# Links in emails (`{subdomain}` → the organisation's): https://{subdomain}.erxes.io
# APP_URL=http://localhost:3500
# Email: smtp (EMAIL_SMTP_URL, e.g. smtps://user:pass@email-smtp.eu-west-1.amazonaws.com:465) or log (development).
# EMAIL_SMTP_URL_FILE=/run/secrets/email_smtp_url
# EMAIL_FROM=erxes <no-reply@example.com>

# Mass-deletion guard (deletes per member or plugin in 10 minutes): owners are told at
# MASS_DELETE_ALERT; at MASS_DELETE_LIMIT members are stopped and plugins suspended.
# MASS_DELETE_ALERT=100
# MASS_DELETE_LIMIT=500
# Failed sign-ins to one account in 15 minutes before owners are alerted (sign-in locks at 10).
# FAILED_SIGN_IN_ALERT=10
# SaaS with erxes.io (global-profile-v2): core reads each workspace's plugins and tiers from it.
# SAAS=true
# SAAS_PLATFORM_URL=https://erxes.io
# SAAS_PLATFORM_TOKEN_FILE=/run/secrets/saas_platform_token   (erxes.io's PLATFORM_API_TOKEN, ≥ 32 characters)
# SAAS_JWT_TOKEN_SECRET_FILE=/run/secrets/saas_jwt_secret      (erxes.io's sign-in hand-off key)
# SAAS_GRACE_DAYS=7
# SAAS_BILLING_URL=https://erxes.io/organizations/{subdomain}/billing
