# erxes core (apps/core-api). Copy to .env for local development.
NODE_ENV=development
PORT=3400

# Postgres for core (core_* tables). Local: docker compose up -d
DATA_URL=postgres://erxes:erxes_local_dev@127.0.0.1:5434/erxes
# DATA_URL_FILE=/run/secrets/data_url
# DATA_SSL=false
# DATA_POOL_MAX=10
# DATA_STATEMENT_TIMEOUT_MS=15000

# Signs core access tokens (until the sign-in slice adds RS256 keys). Required in production.
CORE_JWT_SECRET=replace-with-a-long-random-secret

# Tests: a Postgres where each test file creates and drops its own database
# DATA_TEST_URL=postgres://erxes:erxes_local_dev@127.0.0.1:5434/postgres

# First-run setup screen while the database has no organisation (false on SaaS).
CORE_SETUP=true

# Plugins calling core: `<plugin>:<secret>` pairs (secret ≥ 32 chars), comma-separated.
# A plugin sends `Authorization: Bearer <secret>` and `X-Erxes-Org: <organisation id>`.
# CORE_PLUGIN_KEYS=hr:replace-with-a-long-random-secret-for-hr

# File storage: local (this server's disk) or s3 (AWS S3, Cloudflare R2, MinIO …)
# FILES_STORAGE=local
# FILES_LOCAL_DIR=./data/files
# S3_BUCKET=erxes-files
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # true for MinIO
# The bucket needs CORS allowing PUT from the erxes address (browsers upload directly).
# FILES_MAX_SIZE_MB=50          # deployment limit; organisations can only lower it
# FILES_LINK_TTL_SECONDS=300    # how long upload/download links work
# FILES_PENDING_TTL_HOURS=24    # unfinished uploads are removed after this

# Retention
# AUDIT_RETENTION_DAYS=365
# NOTIFICATIONS_RETENTION_DAYS=90   # read notifications only

# Live updates: a connection that stays open for LISTEN (Postgres directly, or
# Supabase's session pooler on :5432). Derived from DATA_URL when unset (a
# Supabase :6543 URL becomes :5432); `off` disables live updates (browsers poll).
# DATA_LISTEN_URL=
# LIVE_MAX_STREAMS_PER_USER=10
