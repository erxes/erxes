{
  "name": "@erxes/plugin-sdk",
  "version": "0.1.0-v2.27",
  "private": false,
  "description": "For erxes plugin servers: a typed core client with automatic plugin tokens, verification of members' plugin session tokens and of core's deliveries, and plugin jobs",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erxes/erxes.git",
    "directory": "packages/plugin-sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./filter": "./src/filter.ts",
    "./jobs": "./src/jobs.ts",
    "./logger": "./src/logger.ts",
    "./openapi": "./src/openapi.ts",
    "./pluginCalls": "./src/pluginCalls.ts",
    "./verify": "./src/verify.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./client": "./dist/client.js",
      "./filter": "./dist/filter.js",
      "./jobs": "./dist/jobs.js",
      "./logger": "./dist/logger.js",
      "./openapi": "./dist/openapi.js",
      "./pluginCalls": "./dist/pluginCalls.js",
      "./verify": "./dist/verify.js",
      "./package.json": "./package.json"
    },
    "access": "public",
