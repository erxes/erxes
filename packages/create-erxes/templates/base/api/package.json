{
  "name": "@__id__/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "drizzle",
    "src"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": "./src/router.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import ./src/telemetry.ts --watch-path=src src/main.ts",
    "build": "vp pack src/main.ts src/telemetry.ts --format esm --sourcemap --no-dts",
    "start": "node --enable-source-maps --import ./dist/telemetry.mjs dist/main.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../.env src/db/migrate.ts",
    "openapi": "node scripts/openapi.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@erxes/core-contract": "v2-next",
    "@erxes/plugin-sdk": "v2-next",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@orpc/server": "1.16.2",
    "cors": "^2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "^5.3.0",
    "import-in-the-middle": "^3.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@orpc/openapi": "1.16.2",
    "@orpc/zod": "1.16.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
