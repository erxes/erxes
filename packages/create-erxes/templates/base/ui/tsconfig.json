{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "@rsbuild/core/types"],
    "paths": { "@/*": ["./src/modules/*"], "~/*": ["./src/*"] }
  },
  "include": ["src", "rsbuild.config.ts"]
