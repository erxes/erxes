{
  "name": "@erxes/ui",
  "version": "4.0.0-v2.0",
  "private": false,
  "description": "erxes design system: UI primitives, layout, hooks and shared frontend state",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erxes/erxes.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css",
    "./theme.css": "./src/theme.css",
    "./base.css": "./src/base.css",
    "./components.css": "./src/components.css",
    "./*": "./src/*"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./styles.css": "./dist/styles.css",
      "./fonts.css": "./dist/fonts.css",
      "./theme.css": "./dist/theme.css",
      "./base.css": "./dist/base.css",
      "./components.css": "./dist/components.css",
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    },
    "access": "public",
    "provenance": true,
    "tag": "v2-next"
  },
  "scripts": {
    "build": "tsdown",
    "cn:tables": "cn build --full --css src/styles.css --out src/lib/cn-tables.ts --quiet"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@blocknote/core": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@blocknote/shadcn": "0.57.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@formkit/auto-animate": "0.10.2",
    "@hookform/resolvers": "7.0.6",
    "@module-federation/enhanced": "2.9.3",
    "@tabler/icons-react": "3.34.0",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "date-fns": "4.1.0",
    "jotai-family": "1.1.0",
    "libphonenumber-js": "1.12.6",
    "react-day-picker": "10.0.2",
    "react-hook-form": "7.55.0",
    "react-hotkeys-hook": "5.4.0",
    "react-imask": "7.6.1",
    "react-intersection-observer": "11.0.1",
    "react-resizable-panels": "4.21.0",
    "recharts": "3.10.1",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "1.0.7",
    "type-fest": "5.10.0",
    "use-debounce": "^10.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jotai": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1"
  },
  "peerDependencies": {
    "jotai": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.1.1"
  }
}
