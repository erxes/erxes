{
  "name": "erxes-ui",
  "version": "0.0.0",
  "private": true,
  "description": "erxes design system: UI primitives, layout, hooks and shared frontend state",
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css",
    "./theme.css": "./src/theme.css",
    "./base.css": "./src/base.css",
    "./*": "./src/*"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./styles.css": "./dist/styles.css",
      "./fonts.css": "./dist/fonts.css",
      "./theme.css": "./dist/theme.css",
      "./base.css": "./dist/base.css",
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@blocknote/core": "0.35.0",
    "@blocknote/react": "0.35.0",
    "@blocknote/shadcn": "0.35.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "8.0.0",
    "@dnd-kit/sortable": "9.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@formkit/auto-animate": "0.8.2",
    "@hookform/resolvers": "7.0.6",
    "@module-federation/enhanced": "2.9.3",
    "@tabler/icons-react": "3.34.0",
    "@tanstack/react-table": "8.21.2",
    "@tiptap/core": "2.27.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "jotai-family": "1.1.0",
    "libphonenumber-js": "1.12.6",
    "radix-ui": "1.4.3",
    "react-aria-components": "1.10.1",
    "react-day-picker": "9.11.1",
    "react-hook-form": "7.55.0",
    "react-hotkeys-hook": "4.6.2",
    "react-imask": "7.6.1",
    "react-intersection-observer": "9.16.0",
    "react-resizable-panels": "2.1.7",
    "recharts": "3.10.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "1.0.7",
    "type-fest": "4.39.1",
    "use-debounce": "^10.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "jotai": "^2.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.1.1",
    "react-router-dom": "^7.1.1"
  }
}
