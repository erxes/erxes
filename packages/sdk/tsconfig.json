{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "paths": {
      // react.tsx reads only the API URL. Extensions resolve the whole
      // erxes-ui (tsconfig.extension.json); this check doesn't need it.
      "erxes-ui": ["../../frontend/libs/erxes-ui/src/utils/config/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
