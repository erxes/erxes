    "react": "^18.3.1"
  },
  "dependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@module-federation/enhanced": "0.6.6",
    "@rspack/core": "1.0.5",
    "@tailwindcss/postcss": "^4.1.17",
    "esbuild": "^0.19.2",
    "graphql": "^16.10.0",
