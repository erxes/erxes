        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 60,
          "description": "The category of each point in order, such as months or stage names."
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
