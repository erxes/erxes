{
  "protocolVersion": "1.0",
  "catalogId": "https://erxes.io/a2ui/catalogs/assistant/v1.json",
  "instructions": "Lay a surface out with Column and Row; put related content in a Card.\n\nText renders Markdown. A record reference such as [[ref:k2Xp9aQ0vB7LmN4rT]] inside a Text or a Table cell shows as a live link with the record's current name, so write the reference in place of the name.\n\nUse Stat for headline numbers, Table for records or figures in columns, Chart for a trend or a split, and Badge for a status. Use Flow to show an automation, workflow or plan as steps, Callout for something missing or blocking (with a Button that fixes it when you can), and RecordPicker or MemberPicker when the answer is a record or a team member.\n\nAn input keeps what the member enters at the data path it is bound to. Initialise every bound path. A Button's Event(name, context) sends the click to you as the member's next message, with the context's values read at that moment: pass each input's path in the context. The member sees those values under their message, so give options values they can read, such as \"sms\" or \"this_quarter\". openPage(path) opens a workspace page instead.\n\nTo join text with a bound value, use formatString(\"Hello ${/user/name}\"); there are no operators such as +.\n\nGive a validation check its own message; do not add a Text for the error.",
  "components": {
    "Text": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Text"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The text content to display. While simple Markdown formatting is supported (i.e. without HTML, images, or links), utilizing dedicated UI components is generally preferred for a richer and more structured presentation."
        },
        "variant": {
          "type": "string",
          "enum": [
            "caption",
            "body"
          ],
          "description": "A hint for the base text style.",
          "default": "body"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "text"
      ]
    },
    "Row": {
      "type": "object",
      "description": "A layout component that arranges its children horizontally. To create a grid layout, nest Columns within this Row.",
      "properties": {
        "component": {
          "const": "Row"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list. Children cannot be defined inline, they must be referred to by ID."
        },
        "justify": {
          "type": "string",
          "enum": [
            "center",
            "end",
            "spaceAround",
            "spaceBetween",
            "spaceEvenly",
            "start",
            "stretch"
          ],
          "description": "Defines the arrangement of children along the main axis (horizontally). Use 'spaceBetween' to push items to the edges, or 'start'/'end'/'center' to pack them together.",
          "default": "start"
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "description": "Defines the alignment of children along the cross axis (vertically). This is similar to the CSS 'align-items' property, but uses camelCase values (e.g., 'start').",
          "default": "stretch"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "children"
      ]
    },
    "Column": {
      "type": "object",
      "description": "A layout component that arranges its children vertically. To create a grid layout, nest Rows within this Column.",
      "properties": {
        "component": {
          "const": "Column"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list. Children cannot be defined inline, they must be referred to by ID."
        },
        "justify": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "spaceBetween",
            "spaceAround",
            "spaceEvenly",
            "stretch"
          ],
          "description": "Defines the arrangement of children along the main axis (vertically). Use 'spaceBetween' to push items to the edges (e.g. header at top, footer at bottom), or 'start'/'end'/'center' to pack them together.",
          "default": "start"
        },
        "align": {
          "type": "string",
          "enum": [
            "center",
            "end",
            "start",
            "stretch"
          ],
          "description": "Defines the alignment of children along the cross axis (horizontally). This is similar to the CSS 'align-items' property.",
          "default": "stretch"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "children"
      ]
    },
    "List": {
      "type": "object",
      "properties": {
        "component": {
          "const": "List"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list."
        },
        "direction": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal"
          ],
          "description": "The direction in which the list items are laid out.",
          "default": "vertical"
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "description": "Defines the alignment of children along the cross axis.",
          "default": "stretch"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "children"
      ]
    },
    "Card": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Card"
        },
        "child": {
          "$ref": "common_types.json#/$defs/Child",
          "description": "The ID of the single child component to be rendered inside the card. To display multiple elements, you MUST wrap them in a layout component (like Column or Row) and pass that container's ID here. Do NOT pass multiple IDs or a non-existent ID."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "child"
      ]
    },
    "Tabs": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Tabs"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "common_types.json#/$defs/DynamicString",
                "description": "The tab title."
              },
              "child": {
                "$ref": "common_types.json#/$defs/Child",
                "description": "The ID of the child component."
              }
            },
            "required": [
              "title",
              "child"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "An array of objects, where each object defines a tab with a title and a child component."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "tabs"
      ]
    },
    "Divider": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Divider"
        },
        "axis": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "description": "The orientation of the divider.",
          "default": "horizontal"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component"
      ]
    },
    "Button": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Button"
            },
            "child": {
              "$ref": "common_types.json#/$defs/Child",
              "description": "The ID of the child component. Use a 'Text' component for a labeled button. Only use an 'Icon' if the requirements explicitly ask for an icon-only button."
            },
            "variant": {
              "type": "string",
              "enum": [
                "default",
                "primary",
                "borderless"
              ],
              "description": "A hint for the button style. If omitted, a default button style is used. 'primary' indicates this is the main call-to-action button. 'borderless' means the button has no visual border or background, making its child content appear like a clickable link.",
              "default": "default"
            },
            "action": {
              "$ref": "common_types.json#/$defs/Action"
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": [
            "component",
            "child",
            "action"
          ]
        }
      ]
    },
    "TextField": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "TextField"
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The text label for the input field."
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The value of the text field."
            },
            "placeholder": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The placeholder text for the input field."
            },
            "variant": {
              "type": "string",
              "enum": [
                "longText",
                "number",
                "shortText",
                "obscured"
              ],
              "description": "The type of input field to display.",
              "default": "shortText"
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": [
            "component",
            "label"
          ]
        }
      ]
    },
    "CheckBox": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "CheckBox"
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The text to display next to the checkbox."
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicBoolean",
              "description": "The current state of the checkbox (true for checked, false for unchecked)."
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": [
            "component",
            "label",
            "value"
          ]
        }
      ]
    },
    "ChoicePicker": {
      "type": "object",
      "description": "A component that allows selecting one or more options from a list.",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "ChoicePicker"
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The label for the group of options."
            },
            "variant": {
              "type": "string",
              "enum": [
                "multipleSelection",
                "mutuallyExclusive"
              ],
              "description": "A hint for how the choice picker should be displayed and behave.",
              "default": "mutuallyExclusive"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "$ref": "common_types.json#/$defs/DynamicString",
                    "description": "The text to display for this option."
                  },
                  "value": {
                    "type": "string",
                    "description": "The stable value associated with this option."
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              },
              "description": "The list of available options to choose from."
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicStringList",
              "description": "The list of currently selected values. This should be bound to a string array in the data model."
            },
            "displayStyle": {
              "type": "string",
              "enum": [
                "checkbox",
                "chips"
              ],
              "description": "The display style of the component.",
              "default": "checkbox"
            },
            "filterable": {
              "type": "boolean",
              "description": "If true, displays a search input to filter the options.",
              "default": false
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": [
            "component",
            "options",
            "value"
          ]
        }
      ]
    },
    "DateTimeInput": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "DateTimeInput"
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The selected date and/or time value in ISO 8601 format. If not yet set, initialize with an empty string."
            },
            "enableDate": {
              "type": "boolean",
              "description": "If true, allows the user to select a date.",
              "default": false
            },
            "enableTime": {
              "type": "boolean",
              "description": "If true, allows the user to select a time.",
              "default": false
            },
            "min": {
              "allOf": [
                {
                  "$ref": "common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "oneOf": [
                      {
                        "format": "date"
                      },
                      {
                        "format": "time"
                      },
                      {
                        "format": "date-time"
                      }
                    ]
                  }
                }
              ],
              "description": "The minimum allowed date/time in ISO 8601 format."
            },
            "max": {
              "allOf": [
                {
                  "$ref": "common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "oneOf": [
                      {
                        "format": "date"
                      },
                      {
                        "format": "time"
                      },
                      {
                        "format": "date-time"
                      }
                    ]
                  }
                }
              ],
              "description": "The maximum allowed date/time in ISO 8601 format."
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The text label for the input field."
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": [
            "component",
            "value"
          ]
        }
      ]
    },
    "Stat": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Stat"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            },
            {
              "$ref": "common_types.json#/$defs/FunctionCall",
              "description": "Invokes a named function, combining common function properties with the catalog function definition."
            }
          ],
          "description": "What the number measures, such as \"Revenue\"."
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            },
            {
              "$ref": "common_types.json#/$defs/FunctionCall",
              "description": "Invokes a named function, combining common function properties with the catalog function definition."
            }
          ],
          "description": "The number as the member reads it, formatted with its unit, such as \"₮48.2M\"."
        },
        "change": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            },
            {
              "$ref": "common_types.json#/$defs/FunctionCall",
              "description": "Invokes a named function, combining common function properties with the catalog function definition."
            }
          ],
          "description": "The change against the period before, such as \"+12%\"."
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "good",
            "bad"
          ],
          "description": "Whether the change is good or bad news; colours the change."
        }
      },
      "required": [
        "component",
        "label",
        "value"
      ],
      "unevaluatedProperties": false
    },
    "Badge": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Badge"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            },
            {
              "$ref": "common_types.json#/$defs/FunctionCall",
              "description": "Invokes a named function, combining common function properties with the catalog function definition."
            }
          ],
          "description": "One or two words, such as a status."
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "info",
            "good",
            "warning",
            "bad"
          ],
          "description": "The colour of the badge."
        }
      },
      "required": [
        "component",
        "text"
      ],
      "unevaluatedProperties": false
    },
    "Table": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Table"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "The column heading."
              },
              "align": {
                "type": "string",
                "enum": [
                  "start",
                  "end"
                ],
                "description": "end for numbers and money; start otherwise."
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 8,
          "description": "The columns, left to right."
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxItems": 50,
          "description": "One list of cell texts per row, in column order. A cell is plain text, or a record reference such as [[ref:k2Xp9aQ0vB7LmN4rT]] to show the record as a link."
        }
      },
      "required": [
        "component",
        "columns",
        "rows"
      ],
      "unevaluatedProperties": false
    },
    "Chart": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Chart"
        },
        "kind": {
          "type": "string",
          "enum": [
            "bar",
            "line",
            "area",
            "pie"
          ],
