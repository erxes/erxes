      "unevaluatedProperties": false
    },
    "Callout": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Callout"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            },
            {
