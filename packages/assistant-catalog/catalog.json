              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "One number per label, in the same order."
              }
            },
            "required": [
              "name",
              "values"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 6,
          "description": "The series to draw. A pie takes exactly one."
        },
        "title": {
          "type": "string",
          "description": "A heading above the chart."
        }
      },
      "required": [
        "component",
        "kind",
        "labels",
        "series"
      ],
      "unevaluatedProperties": false
    },
    "MemberPicker": {
      "type": "object",
      "properties": {
        "component": {
          "const": "MemberPicker"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            },
            {
              "$ref": "common_types.json#/$defs/FunctionCall",
