{
  "name": "erxes-api-shared",
  "version": "0.50.0-canary",
  "description": "Shared platform utilities for erxes backend plugins: plugin startup, tenant-scoped models, service discovery, messaging and core types.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/erxes/erxes.git",
    "directory": "backend/erxes-api-shared"
  },
  "main": "dist/erxes-api-shared.cjs.js",
  "module": "dist/erxes-api-shared.esm.js",
  "types": "dist/erxes-api-shared.cjs.d.ts",
  "exports": {
    ".": {
      "module": "./dist/erxes-api-shared.esm.js",
      "default": "./dist/erxes-api-shared.cjs.js"
    },
    "./utils": {
      "module": "./utils/dist/erxes-api-shared-utils.esm.js",
      "default": "./utils/dist/erxes-api-shared-utils.cjs.js"
    },
    "./core-types": {
      "module": "./core-types/dist/erxes-api-shared-core-types.esm.js",
      "default": "./core-types/dist/erxes-api-shared-core-types.cjs.js"
    },
    "./core-modules": {
      "module": "./core-modules/dist/erxes-api-shared-core-modules.esm.js",
      "default": "./core-modules/dist/erxes-api-shared-core-modules.cjs.js"
    },
    "./package.json": "./package.json",
    "./src": "./src/index.ts",
    "./src/*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "build": "preconstruct build",
    "prepare": "preconstruct build"
  },
  "engines": {
    "pnpm": ">=8",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@preconstruct/cli": "^2.8.12",
    "@prettier/sync": "^0.5.2",
    "@types/babel__preset-env": "^7",
    "@types/graphql": "^14.5.0",
    "@types/ioredis": "^5.0.0",
    "@types/lodash": "^4.17.21",
    "@types/nodemailer": "^6.4.17",
    "babel-plugin-module-resolver": "^5.0.2",
    "glob": "^11.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@apollo/subgraph": "^2.9.3",
    "@azure/storage-blob": "^12.29.1",
    "@google-cloud/storage": "^7.17.3",
    "@sendgrid/mail": "^8.1.5",
    "@sentry/node": "^10.55.0",
    "@sniptt/guards": "^0.2.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "aws-sdk": "^2.1692.0",
    "bullmq": "^5.40.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dataloader": "^2.2.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "file-type": "^20.5.0",
    "form-data": "^4.0.2",
    "graphql": "^16.9.0",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-subscriptions": "^3.0.0",
    "ioredis": "^5.6.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mongoose": "^8.10.0",
    "nanoid": "^3.3.6",
    "node-fetch": "^2.6.7",
    "nodemailer": "^6.9.10",
    "strip-ansi": "^6.0.1",
    "tslib": "^2.3.0",
    "zod": "3.23.8"
  },
  "preconstruct": {
    "tsconfig": "tsconfig.lib.json",
    "exports": {
      "extra": {
        "./src": "./src/index.ts",
        "./src/*": [
          "./src/*.ts",
          "./src/*/index.ts"
        ],
        "./package.json": "./package.json"
      }
    },
    "entrypoints": [
      "./index.ts",
      "./utils/index.ts",
      "./core-types/index.ts",
      "./core-modules/index.ts"
    ]
  },
  "files": [
    "dist",
    "core-types",
    "utils",
    "core-modules",
    "src"
  ]
}
