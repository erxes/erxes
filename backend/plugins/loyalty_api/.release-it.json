{
  "npm": {
    "publish": false
  },
  "git": {
    "commitMessage": "release loyalty_api ${version}",
    "tagName": "loyalty_api@${version}",
    "tagMatch": "loyalty_api@*",
    "tagAnnotation": "Release loyalty_api ${version}",
    "commitsPath": "."
  },
  "github": {
    "release": true,
    "releaseName": "loyalty_api v${version}",
    "makeLatest": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "angular"
      },
      "infile": "CHANGELOG.md",
      "gitRawCommitsOpts": {
        "path": "."
      }
    }
  }
}
