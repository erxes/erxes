{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/modules/*"]
    },
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "jest.config.ts",
    "**/*spec.ts",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
