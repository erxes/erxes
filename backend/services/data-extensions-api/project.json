{
  "name": "data-extensions-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/services/data-extensions-api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "backend/services/data-extensions-api",
        "commands": ["pnpm build"]
      },
      "dependsOn": ["^build", "build:packageJson"]
    },
    "build:packageJson": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "backend/services/data-extensions-api/dist/src/main.js",
        "tsConfig": "backend/services/data-extensions-api/tsconfig.build.json",
        "outputPath": "backend/services/data-extensions-api/dist",
        "updateBuildableProjectDepsInPackageJson": true,
        "buildableProjectDepsInPackageJsonType": "dependencies"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/services/data-extensions-api",
        "command": "NODE_ENV=development pnpm dev"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "backend/services/data-extensions-api/jest.config.ts"
      }
    },
    "docker-build": {
      "dependsOn": ["build"],
      "command": "docker build -f backend/services/data-extensions-api/Dockerfile . -t erxes/erxes-next-data-extensions-api"
    }
  }
}
