{
  "name": "erxes",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @erxes/core-api --filter @erxes/core-ui dev",
    "dev:api": "pnpm --filter @erxes/core-api dev",
    "dev:ui": "pnpm --filter @erxes/core-ui dev",
    "build": "pnpm -r build",
    "check": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint vp check && knip",
    "fix": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint vp check --fix",
    "test": "vp test run",
    "prepare": "vp config --no-agent",
    "db:generate": "pnpm --filter @erxes/core-db db:generate",
    "db:check": "pnpm --filter @erxes/core-db db:check",
    "db:migrate": "pnpm --filter @erxes/core-api db:migrate",
    "db:grant": "pnpm --filter @erxes/core-api db:grant",
    "db:plugin-role": "pnpm --filter @erxes/core-api db:plugin-role",
    "bootstrap": "pnpm --filter @erxes/core-api bootstrap",
    "plugin:secret": "pnpm --filter @erxes/core-api plugin:secret",
    "bench:filters": "pnpm --filter @erxes/core-api bench:filters",
    "openapi": "pnpm --filter @erxes/core-api openapi",
    "check:generated": "tools/check-generated.sh",
    "verify:models": "tools/verify-models.sh",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@erxes/core-contract": "workspace:*",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/openapi-client": "1.16.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "knip": "^6.45.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "~7.0.2",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.2"
}
