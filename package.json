{
  "name": "erxes",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm --parallel --filter @erxes/core-api --filter @erxes/core-ui dev",
    "dev:api": "pnpm --filter @erxes/core-api dev",
    "dev:ui": "pnpm --filter @erxes/core-ui dev",
    "build": "pnpm -r build",
    "test": "vp test run",
    "db:generate": "pnpm --filter @erxes/core-db db:generate",
    "db:check": "pnpm --filter @erxes/core-db db:check",
    "bootstrap": "pnpm --filter @erxes/core-api bootstrap",
    "plugin:secret": "pnpm --filter @erxes/core-api plugin:secret",
    "check": "vp check && knip",
    "fix": "vp check --fix",
    "prepare": "vp config --no-agent",
    "openapi": "pnpm --filter @erxes/core-api openapi",
    "check:generated": "tools/check-generated.sh"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "knip": "^6.45.1",
    "typescript": "~7.0.2",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@1.6.0",
      "vitest@*": "5.1.0"
    }
  }
}
