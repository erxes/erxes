{
  "name": "erxes",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @erxes/core-api --filter @erxes/core-ui dev",
    "dev:api": "pnpm --filter @erxes/core-api dev",
    "dev:ui": "pnpm --filter @erxes/core-ui dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @erxes/core-db db:generate",
    "db:check": "pnpm --filter @erxes/core-db db:check",
    "bootstrap": "pnpm --filter @erxes/core-api bootstrap",
    "plugin:secret": "pnpm --filter @erxes/core-api plugin:secret",
    "db:migrate": "pnpm --filter @erxes/core-api db:migrate",
    "db:grant": "pnpm --filter @erxes/core-api db:grant"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.7.3",
    "vitest": "^3.0.0"
  }
}
