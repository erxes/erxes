{
  "name": "accounting_ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "frontend/plugins/accounting_ui/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "dependsOn": ["codegen"],
      "options": {
        "jestConfig": "frontend/plugins/accounting_ui/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        { "projects": ["accounting_api"], "target": "schema:print" }
      ],
      "inputs": [
        "{projectRoot}/codegen.ts",
        "{projectRoot}/schema/**/*.graphql",
        "{projectRoot}/src/**/*.{ts,tsx}",
        "!{projectRoot}/src/gql/**",
        { "dependentTasksOutputFiles": "**/*.graphql" }
      ],
      "outputs": ["{projectRoot}/src/gql"],
      "options": {
        "cwd": "frontend/plugins/accounting_ui",
        "command": "graphql-codegen --config codegen.ts"
      }
    },
    "build": {
      "dependsOn": ["codegen"],
      "executor": "@nx/rspack:rspack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "web",
        "outputPath": "dist/frontend/plugins/accounting_ui",
        "main": "frontend/plugins/accounting_ui/src/main.ts",
        "tsConfig": "frontend/plugins/accounting_ui/tsconfig.app.json",
        "rspackConfig": "frontend/plugins/accounting_ui/rspack.config.ts",
        "assets": ["frontend/plugins/accounting_ui/src/assets"]
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production",
          "optimization": true,
          "sourceMap": false,
          "rspackConfig": "frontend/plugins/accounting_ui/rspack.config.prod.ts"
        }
      }
    },
    "serve": {
      "dependsOn": ["codegen"],
      "executor": "@nx/rspack:module-federation-dev-server",
      "options": {
        "buildTarget": "accounting_ui:build:development",
        "port": 3008
      },
      "configurations": {
        "development": {},
        "production": {
          "buildTarget": "accounting_ui:build:production"
        }
      }
    },
    "serve-static": {
      "executor": "@nx/rspack:module-federation-static-server",
      "defaultConfiguration": "production",
      "options": {
        "serveTarget": "accounting_ui:serve"
      },
      "configurations": {
        "development": {
          "serveTarget": "accounting_ui:serve:development"
        },
        "production": {
          "serveTarget": "accounting_ui:serve:production"
        }
      }
    }
  }
}
