{
  "name": "ui-modules",
  "version": "1.0.0",
  "description": "Shared erxes business UI modules: contacts, products, tags, automations and record widgets",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/erxes/erxes.git",
    "directory": "frontend/libs/ui-modules"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": [
        "./dist/index.d.ts",
        "./src/index.ts"
      ],
      "default": "./src/index.ts"
    },
    "./*": {
      "types": [
        "./dist/*.d.ts",
        "./dist/*/index.d.ts",
        "./src/*.ts",
        "./src/*/index.ts"
      ],
      "default": [
        "./src/*.tsx",
        "./src/*.ts",
        "./src/*/index.tsx",
        "./src/*/index.ts"
      ]
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build:dts": "tsc -p tsconfig.dts.json"
  },
  "peerDependencies": {
    "@apollo/client": "^3.11.8",
    "erxes-ui": "1.0.0",
    "graphql": "^16.10.0",
    "jotai": "^2.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "react-router": "^7.1.5",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "erxes-ui": "workspace:*",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@blocknote/core": "^0.35.0",
    "@blocknote/react": "^0.35.0",
    "@codemirror/view": "^6.38.6",
    "@dnd-kit/core": "^6.2.0",
    "@dnd-kit/modifiers": "^8.0.0",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/table-core": "^8.20.5",
    "@types/lodash": "^4.17.21",
    "@xyflow/react": "^12.8.3",
    "class-variance-authority": "^0.7.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.0.6",
    "frimousse": "^0.3.0",
    "graphql-tag": "^2.12.6",
    "i18next": "^23.16.4",
    "libphonenumber-js": "^1.11.20",
    "lodash": "^4.17.21",
    "motion": "^11.11.17",
    "nanoid": "^3.3.6",
    "qz-tray": "^2.2.6",
    "radix-ui": "^1.4.3",
    "react-hook-form": "^7.53.2",
    "react-intersection-observer": "^9.13.1",
    "recharts": "^3.1.2",
    "use-debounce": "^10.0.4",
    "zod": "^3.23.8"
  }
}
