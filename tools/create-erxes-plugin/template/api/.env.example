# Copy to .env — changeme_api runtime config
PORT=__API_PORT__
NODE_ENV=development

MONGO_URL=mongodb://127.0.0.1:27017/erxes?directConnection=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Set on erxes saas only: resolves per-subdomain org databases
# VERSION=saas
# CORE_MONGO_URL=mongodb://...
# DB_NAME=erxes_<organizationId>

# Plugin release line — drives the UI remoteEntry version core serves
# RELEASE_VERSION=3.0.0

# Public address the gateway should proxy to instead of plugin-<name>-api:<port>
# LOAD_BALANCER_ADDRESS=http://changeme-api:__API_PORT__
