{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "related": true },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "ignorers": ["erxes-logging", "erxes-error-messages"],
  "inPlace": true,
  "disableTypeChecks": false,
  "incremental": true,
  "incrementalFile": ".scratch/mutation/previous.json",
  "reporters": ["json", "html", "clear-text"],
  "jsonReporter": { "fileName": ".scratch/mutation/mutation.json" },
  "htmlReporter": { "fileName": ".scratch/mutation/mutation.html" },
  "clearTextReporter": { "allowColor": false, "logTests": false, "reportScoreTable": false },
  "tempDirName": ".scratch/mutation/tmp",
  "cleanTempDir": "always",
  "timeoutMS": 30000,
  "dryRunTimeoutMinutes": 30,
  "thresholds": { "high": 80, "low": 60, "break": null },
  "warnings": { "slow": false }
}
