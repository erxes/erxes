# deploy/docker-compose.yml settings. Copy to deploy/.env.
APP_URL=https://erxes.example.com
UI_PORT=8080
# Passwords for the bundled Postgres: the owner (migrations) and erxes_app (the API).
DATA_OWNER_PASSWORD=
DATA_APP_PASSWORD=
# Images (default: the latest postgre build). Pin a commit for repeatable deploys:
# API_IMAGE=ghcr.io/erxes/erxes-api:sha-<commit>
# WEB_IMAGE=ghcr.io/erxes/erxes-web:sha-<commit>
# CORE_SETUP=true
# FILES_STORAGE=local
# EMAIL_DRIVER=log
