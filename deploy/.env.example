# deploy/docker-compose.yml settings. Copy to deploy/.env.
APP_URL=https://erxes.example.com
UI_PORT=8080
# Passwords for the bundled Postgres: the owner (migrations) and erxes_app (the API).
DATA_OWNER_PASSWORD=
DATA_APP_PASSWORD=
# Images (default: the latest postgre build). Pin a commit for repeatable deploys:
# API_IMAGE=ghcr.io/erxes/erxes-api:sha-<commit>
# WEB_IMAGE=ghcr.io/erxes/erxes-web:sha-<commit>
# CORE_SETUP=true
# FILES_STORAGE=local
# Email: the server's SMTP (SES, SendGrid, …); or set up a provider per organisation in
# Settings › Integrations › Email sending. Without either, email isn't delivered.
# EMAIL_SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM=erxes <no-reply@example.com>
# Only to try erxes out: emails go to the API's log and broadcasts are refused.
# EMAIL_DRIVER=log
