# erxes gateway (Apollo Router). No trailing slash.
NEXT_PUBLIC_ERXES_API_URL=https://officenext.erxes.io/gateway

# Client portal app token — identifies the portal the CMS/ticket `cp*` queries
# resolve their client portal from.
NEXT_PUBLIC_ERXES_CP_TOKEN=

# Frontline knowledge base topic this portal renders
# (Frontline → Knowledge Base → topic, the `topicId` in the admin URL).
NEXT_PUBLIC_ERXES_KB_TOPIC_ID=

# Ticket surfaces — the Frontline ticket pipeline new client-portal requests
# land in, its channel, and the status they start at.
NEXT_PUBLIC_ERXES_TICKET_PIPELINE_ID=
NEXT_PUBLIC_ERXES_TICKET_CHANNEL_ID=
NEXT_PUBLIC_ERXES_TICKET_STATUS_ID=

# Frontline forms the portal offers. The channel defaults to the ticket channel
# above; the tag is what marks a form as belonging here — tag a form in
# Frontline → Forms and paste that tag's id, or nothing is listed.
NEXT_PUBLIC_ERXES_FORM_CHANNEL_ID=
NEXT_PUBLIC_ERXES_FORM_TAG_ID=
